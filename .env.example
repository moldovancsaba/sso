# .env.example — every variable the service actually reads, and nothing else.
# Copy to .env.local (npm run setup). Vars marked (required) break the relevant
# feature when absent; everything else has the documented default.

# --- MongoDB (lib/db.mjs) ---
MONGODB_URI=mongodb://localhost:27017/sso        # (required)
MONGODB_DB=sso                                   # default: sso
# MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
# MONGO_CONNECT_TIMEOUT_MS=5000
# MONGO_SOCKET_TIMEOUT_MS=5000

# --- Canonical base URL (lib/baseUrl.mjs) ---
# Precedence: this var -> Vercel preview host -> https://sso.doneisbetter.com in
# production -> http://localhost:5500 in development. Set it explicitly on any
# deployment that is not the production domain.
SSO_BASE_URL=http://localhost:5500

# --- Origins, cookies, redirects ---
# CORS + CSRF allowlist (lib/cors.mjs, lib/middleware/csrf.mjs). No automatic
# localhost allowance: add your local frontend origin here when developing.
SSO_ALLOWED_ORIGINS=https://sso.doneisbetter.com,https://doneisbetter.com
# Cookie Domain for cross-subdomain SSO. Leave UNSET on Vercel previews/forks:
# lib/publicSessions.mjs otherwise forces .doneisbetter.com and the browser
# drops the cookie, so login silently fails off-domain.
SSO_COOKIE_DOMAIN=.doneisbetter.com
ADMIN_SESSION_COOKIE=admin-session               # default: admin-session
PUBLIC_SESSION_COOKIE=public-session             # default: public-session
# Extra origin considered safe for post-login redirects (lib/redirects.mjs)
# NEXT_PUBLIC_SSO_BASE_URL=

# --- Secrets (generate each: openssl rand -base64 32) ---
JWT_SECRET=REPLACE_ME                            # (required) HS256 fallback + public magic links
CSRF_SECRET=REPLACE_ME                           # (required; falls back to SESSION_SECRET)
# SESSION_SECRET=                                # only read as CSRF_SECRET fallback
ADMIN_MAGIC_SECRET=REPLACE_ME                    # (required for admin magic links — absent means they silently never send)
# PUBLIC_MAGIC_SECRET=                           # public magic links; falls back to JWT_SECRET

# --- OAuth2/OIDC token signing (lib/oauth/tokens.mjs) ---
# Inline PEM contents, not file paths. Without them the code falls back to
# keys/private.pem and keys/public.pem on disk.
# Generate: openssl genrsa -out keys/private.pem 2048 && openssl rsa -in keys/private.pem -pubout -out keys/public.pem
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
# JWT_ISSUER=                                    # default: the canonical base URL (must match discovery)
# JWT_KEY_ID=sso-2025
# OAUTH2_ACCESS_TOKEN_LIFETIME=3600
# OAUTH2_REFRESH_TOKEN_LIFETIME=2592000

# --- Email transport (lib/email.mjs) ---
EMAIL_PROVIDER=nodemailer                        # nodemailer | resend
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# RESEND_API_KEY=                                # (required when EMAIL_PROVIDER=resend)
EMAIL_FROM=noreply@example.com                   # set this — the default is a placeholder
EMAIL_FROM_NAME=SSO Service

# --- Social login ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://sso.doneisbetter.com/api/auth/google/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=https://sso.doneisbetter.com/api/auth/facebook/callback

# --- Login/admin behavior ---
SSO_ADMIN_ALIAS_EMAIL=sso@doneisbetter.com       # what the 'admin' shortcut resolves to
# ADMIN_MAGIC_ALLOWED_EMAILS=                    # optional comma-separated allowlist for admin magic links
# DISABLE_LOGIN_PIN=true                         # skip the random email-PIN check at login
# ADMIN_FRESH_AUTH_WINDOW_MS=                    # how recent an admin login must be for sensitive ops
# ADMIN_DEV_BYPASS=true                          # DEV ONLY — never set in production
# ADMIN_DEV_ROLE=super-admin                     # role granted by the dev bypass

# --- Rate limiting (lib/middleware/rateLimit.mjs) ---
# RATE_LIMIT_LOGIN_WINDOW=900000                 # ms, default 15 min
# RATE_LIMIT_LOGIN_MAX=5                         # attempts per window

# --- Token TTLs (seconds) ---
# PASSWORD_RESET_TOKEN_TTL=900
# EMAIL_VERIFICATION_TOKEN_TTL=86400

# --- Logging (lib/logger.mjs) ---
LOG_LEVEL=info
# LOG_FILE_PATH=

# --- Script-only (not read by the service) ---
# NEW_MAGIC_EMAIL=                               # scripts/generate-magic-link.mjs, scripts/test-magic-link.mjs
# MAGIC_TTL_SECONDS=900                          # scripts/generate-magic-link.mjs only
