# .env.example — every variable the service actually reads, and nothing else.
# Copy to .env.local (npm run setup). Vars marked (required) break the relevant
# feature when absent; everything else has the documented default.
#
# Naming: every variable this service owns starts with SSO_ (NEXT_PUBLIC_SSO_ for
# browser-visible ones). The older unprefixed names (MONGODB_URI, JWT_SECRET, ...) are
# still read as a fallback for now, so an existing environment keeps working; when both
# are set the SSO_ name wins. Platform variables (NODE_ENV, VERCEL_*) keep their names.

# --- MongoDB (lib/db.mjs) ---
SSO_MONGODB_URI=mongodb://localhost:27017/sso        # (required)
SSO_MONGODB_DB=sso                                   # default: sso
# SSO_MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
# SSO_MONGO_CONNECT_TIMEOUT_MS=5000
# SSO_MONGO_SOCKET_TIMEOUT_MS=5000

# --- Canonical base URL (lib/baseUrl.mjs) ---
# Precedence: this var -> Vercel preview host -> https://sso.doneisbetter.com in
# production -> http://localhost:5500 in development. Set it explicitly on any
# deployment that is not the production domain.
SSO_BASE_URL=http://localhost:5500

# --- Origins, cookies, redirects ---
# CORS + CSRF allowlist (lib/cors.mjs, lib/middleware/csrf.mjs). No automatic
# localhost allowance: add your local frontend origin here when developing.
SSO_ALLOWED_ORIGINS=https://sso.doneisbetter.com,https://doneisbetter.com
# Cookie Domain for cross-subdomain SSO. Leave UNSET on Vercel previews/forks:
# lib/publicSessions.mjs otherwise forces .doneisbetter.com and the browser
# drops the cookie, so login silently fails off-domain.
SSO_COOKIE_DOMAIN=.doneisbetter.com
SSO_ADMIN_SESSION_COOKIE=admin-session               # default: admin-session
SSO_PUBLIC_SESSION_COOKIE=public-session             # default: public-session
# Extra origin considered safe for post-login redirects (lib/redirects.mjs)
# NEXT_PUBLIC_SSO_BASE_URL=

# --- Secrets (generate each: openssl rand -base64 32) ---
SSO_JWT_SECRET=REPLACE_ME                            # (required) HS256 fallback + public magic links
SSO_CSRF_SECRET=REPLACE_ME                           # (required; falls back to SSO_SESSION_SECRET)
# SSO_SESSION_SECRET=                                # only read as SSO_CSRF_SECRET fallback
SSO_ADMIN_MAGIC_SECRET=REPLACE_ME                    # (required for admin magic links — absent means they silently never send)
# SSO_PUBLIC_MAGIC_SECRET=                           # public magic links; falls back to SSO_JWT_SECRET

# --- OAuth2/OIDC token signing (lib/oauth/tokens.mjs) ---
# Inline PEM contents, not file paths. Without them the code falls back to
# keys/private.pem and keys/public.pem on disk.
# Generate: openssl genrsa -out keys/private.pem 2048 && openssl rsa -in keys/private.pem -pubout -out keys/public.pem
# SSO_JWT_PRIVATE_KEY=
# SSO_JWT_PUBLIC_KEY=
# SSO_JWT_ISSUER=                                    # default: the canonical base URL (must match discovery)
# SSO_JWT_KEY_ID=sso-2025
# SSO_OAUTH2_ACCESS_TOKEN_LIFETIME=3600
# SSO_OAUTH2_REFRESH_TOKEN_LIFETIME=2592000

# --- Email transport (lib/email.mjs) ---
SSO_EMAIL_PROVIDER=nodemailer                        # nodemailer | resend
SSO_SMTP_HOST=smtp.gmail.com
SSO_SMTP_PORT=465
SSO_SMTP_SECURE=true
SSO_SMTP_USER=
SSO_SMTP_PASS=
# SSO_RESEND_API_KEY=                                # (required when SSO_EMAIL_PROVIDER=resend)
SSO_EMAIL_FROM=noreply@example.com                   # set this — the default is a placeholder
SSO_EMAIL_FROM_NAME=SSO Service

# --- Social login ---
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=
SSO_GOOGLE_REDIRECT_URI=https://sso.doneisbetter.com/api/auth/google/callback
SSO_FACEBOOK_APP_ID=
SSO_FACEBOOK_APP_SECRET=
SSO_FACEBOOK_REDIRECT_URI=https://sso.doneisbetter.com/api/auth/facebook/callback

# --- Login/admin behavior ---
SSO_ADMIN_ALIAS_EMAIL=sso@doneisbetter.com       # what the 'admin' shortcut resolves to
# SSO_ADMIN_MAGIC_ALLOWED_EMAILS=                    # optional comma-separated allowlist for admin magic links
# SSO_DISABLE_LOGIN_PIN=true                         # skip the random email-PIN check at login
# SSO_ADMIN_FRESH_AUTH_WINDOW_MS=                    # how recent an admin login must be for sensitive ops
# SSO_ADMIN_DEV_BYPASS=true                          # DEV ONLY — never set in production
# SSO_ADMIN_DEV_ROLE=super-admin                     # role granted by the dev bypass

# --- Rate limiting (lib/middleware/rateLimit.mjs) ---
# SSO_RATE_LIMIT_LOGIN_WINDOW=900000                 # ms, default 15 min
# SSO_RATE_LIMIT_LOGIN_MAX=5                         # attempts per window

# --- Token TTLs (seconds) ---
# SSO_PASSWORD_RESET_TOKEN_TTL=900
# SSO_EMAIL_VERIFICATION_TOKEN_TTL=86400

# --- Logging (lib/logger.mjs) ---
SSO_LOG_LEVEL=info
# SSO_LOG_FILE_PATH=

# --- Script-only (not read by the service) ---
# SSO_NEW_MAGIC_EMAIL=                               # scripts/generate-magic-link.mjs, scripts/test-magic-link.mjs
# SSO_MAGIC_TTL_SECONDS=900                          # scripts/generate-magic-link.mjs only

# --- Maintenance scripts (scripts/, tools/) ---
# Read only by the script named on each line; set them for that run, not in deployments.
# SSO_ADMIN_EMAIL=                          # scripts/fix-admin-role.mjs, scripts/grant-admin-access.mjs
# SSO_AMANOBA_ADMIN_EMAIL=                  # scripts/get-amanoba-admin-token.mjs
# SSO_AMANOBA_ADMIN_PASSWORD=               # scripts/get-amanoba-admin-token.mjs
# SSO_AMANOBA_BASE_URL=                     # scripts/check-amanoba-auth.mjs, scripts/get-amanoba-admin-token.mjs, scripts/test-amanoba-sso-integration.mjs, scripts/test-amanoba-token.mjs
# SSO_DRY_RUN=                              # scripts/enable-m2m-clients.mjs, scripts/merge-duplicate-accounts.mjs
# SSO_EMAIL=                                # scripts/diagnose-admin-access.mjs, scripts/grant-admin-permission.mjs
# SSO_LAUNCHMASS_CLIENT_SECRET=             # scripts/add-launchmass-prod-client.mjs
# SSO_M2M_CLIENTS=                          # scripts/enable-m2m-clients.mjs
# SSO_M2M_SCOPE=                            # scripts/enable-m2m-clients.mjs
# SSO_NEW_ADMIN_TOKEN=                      # scripts/bootstrap-admin.mjs
# SSO_QUIZ_ITEM_ADMIN_TOKEN=                # scripts/amanoba-proxy-test.mjs, scripts/decode-jwt.mjs, scripts/test-amanoba-sso-integration.mjs, scripts/test-amanoba-token.mjs
# SSO_REVOKE_M2M=                           # scripts/enable-m2m-clients.mjs
# SSO_SECRET_OUT=                           # scripts/register-management-staff-agent-client.mjs, scripts/register-openclaw-worker-client.mjs, scripts/register-try-on-client.mjs
# SSO_UPSERT_EMAIL=                         # scripts/upsert-admin-user.mjs
# SSO_UPSERT_NAME=                          # scripts/upsert-admin-user.mjs
# SSO_UPSERT_PASSWORD=                      # scripts/upsert-admin-user.mjs
# SSO_UPSERT_ROLE=                          # scripts/upsert-admin-user.mjs
# SSO_USERINFO_URL=                         # scripts/test-amanoba-sso-integration.mjs
