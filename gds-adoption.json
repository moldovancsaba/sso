{
  "schemaVersion": 1,
  "gdsVersion": "6.0.0",
  "productArchetype": "hybrid",
  "supportedEntryPoints": [
    "@sovereignsquad/gds-theme/client",
    "@sovereignsquad/gds-theme/server",
    "@sovereignsquad/gds-core/server",
    "@sovereignsquad/gds-admin/client",
    "@sovereignsquad/gds-admin/server"
  ],
  "requiredContracts": [
    "AppShell",
    "PageHeader",
    "DataToolbar",
    "ResponsiveDataView",
    "AuthShell",
    "ArticleShell",
    "PublicShell",
    "StateBlock",
    "EditorialHero",
    "FeatureBand",
    "ConsumerSection",
    "EditorialCard"
  ],
  "localAdapters": [
    {
      "contract": "DocsPageShell",
      "path": "components/DocsLayout.js",
      "status": "active"
    }
  ],
  "approvedExceptions": [
    {
      "surface": "Docs editorial surfaces",
      "category": "migration-bridge",
      "scope": [
        "components/DocsLayout.js",
        "pages/docs/*",
        "pages/docs/api/*",
        "pages/docs/examples/*",
        "pages/docs/security/*"
      ],
      "allowedImplementation": "Use local docs-shell wrapper only for docs navigation/framing while pages consume GDS primitives directly where available.",
      "mustStillUse": [
        "@sovereignsquad/gds-core/server",
        "@sovereignsquad/gds-theme/client",
        "@sovereignsquad/gds-theme/server"
      ],
      "mustNotDo": [
        "Reintroduce local design-token authority",
        "Add new non-GDS visual primitives for docs shells or layouts",
        "Expand exception scope beyond docs routes"
      ],
      "exitCondition": "Delete DocsLayout and migrate all docs routes to direct canonical package-level shell composition.",
      "status": "temporary",
      "reason": "The docs area still carries a local docs-site shell wrapper and two targeted lint waivers on long-form prose-heavy docs pages.",
      "owner": "sso-platform",
      "reviewDate": "2026-11-08"
    }
  ],
  "compliance": {
    "documentationPaths": [
      "README.md",
      "docs/README.md",
      "docs/ARCHITECTURE.md",
      "docs/DESIGN_SYSTEM.md"
    ],
    "staleDocumentationReferences": [
      "@gds/",
      "/Users/Shared/Projects/GENERAL_DESIGN_SYSTEM"
    ],
    "protectedSurfacePaths": [
      "components",
      "lib/theme",
      "pages"
    ],
    "bannedImports": [
      "@gds/theme",
      "@gds/theme/client",
      "@gds/theme/server",
      "@gds/core",
      "@gds/core/client",
      "@gds/core/server",
      "@gds/admin",
      "@gds/admin/client",
      "@gds/admin/server",
      "@gds/eslint-config",
      "@gds/compliance"
    ],
    "identityProviderBranding": {
      "approvedProviders": ["google", "facebook"],
      "forbiddenCustomizations": ["leftSection", "rightSection", "variant", "size"],
      "allowedVariants": ["solid", "outline", "neutral"],
      "colorAuthority": "provider",
      "minTouchTargetPx": 44,
      "policyDocument": "IDENTITY_PROVIDER_BRANDING.md"
    }
  },
  "migrationStatus": "mostly-direct",
  "owner": "sso-platform",
  "lastReviewedAt": "2026-08-12"
}
